# Скопируйте в .env и заполните.

# Локальная база SQLite.
DATABASE_URL="file:./dev.db"

# Токен бота, которому уходят заявки. Получить у @BotFather.
# Пока пусто, форма записи будет показывать прямой контакт вместо брони.
TELEGRAM_BOT_TOKEN=""

# Числовой id чата мастера. Узнать: написать боту и открыть
# https://api.telegram.org/bot<ТОКЕН>/getUpdates
TELEGRAM_CHAT_ID=""

# Секрет для подписи ссылок мастера, минимум 16 символов.
# Сгенерировать: openssl rand -hex 32
BOOKING_SECRET=""

# Адрес сайта — из него собираются ссылки в сообщениях мастеру.
SITE_URL="http://localhost:3000"
